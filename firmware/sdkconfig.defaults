# SAS-Watch firmware: Waveshare ESP32-S3-Touch-AMOLED-2.06 / ESP-IDF 5.5

CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB として使う。実機は GD25Q256 32MB (docs/board.md)
# 16MB 超のアクセスには実験的オプションが要るので当面 16MB
# TODO(hw): 実機で flash_id 確認後に 32MB を検討 (plan.md A-3)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# パーティションは docs/plan.md I 章の案
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: ESP32-S3R8 Octal 8MB, 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_USE_MALLOC=y

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS 1000Hz
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE のみ (Bluedroid は使わない)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# ble_link (docs/protocol-v1.md): ボンド情報を NVS に保存して再接続を速くする
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# ATT MTU 要求値は 247 (protocol-v1.md)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# LE Secure Connections (Numeric Comparison) を必須にする
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
# 時計は同時に1台だけ繋ぐ (RAM 節約)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 電源管理: tickless idle で自動 light sleep (plan.md L 章)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# LVGL: 公式サンプル 02_lvgl_demo_v9 / BSP v2 推奨設定ベース
# 日本語フォントはまだ無し (plan.md I 章)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OS_FREERTOS=y
# LVGL の fast_mem を IRAM に置くと ~104KB 食って IRAM が溢れる (vector の j が届かない)。
# フラッシュキャッシュ経由で遅くなるかは要実機確認。
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
