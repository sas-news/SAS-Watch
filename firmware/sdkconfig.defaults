# SAS-Watch firmware: Waveshare ESP32-S3-Touch-AMOLED-2.06 / ESP-IDF 5.5

CONFIG_IDF_TARGET="esp32s3"

# Flash: 実機は GD25Q256 32MB (docs/board.md, flash_id 実測済み)。
# ESP32-S3 は SOC_SPI_MEM_SUPPORT_CACHE_32BIT_ADDR_MAP=1 なので
# 32MB 全体が実験的オプションなしで使える。パーティションも 32MB 前提。
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# パーティションは docs/plan.md I 章の案
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# この機体はスピーカー/コーデック IC を物理撤去済み。
# audio を有効のままにすると bsp_audio_init() が I2S DMA バッファの
# 内蔵RAM確保失敗 (i2s_alloc_dma_desc ESP_ERR_NO_MEM) で abort するため
# 音声初期化ごと無効化する (コード自体は残る)。搭載機体では n にするか消す。
# 音声: マイク (録音) だけ先行有効化。スピーカーは未検証のため off。
# CONFIG_WATCH_DISABLE_AUDIO is not set
CONFIG_WATCH_ENABLE_MIC=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: ESP32-S3R8 Octal 8MB, 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_USE_MALLOC=y
# 内部SRAMの席取り抑制: 既定16384B以下のMALLOC_CAP_DEFAULT allocは
# 全部内部に行くので、30KB連続ブロックが必要なBLEコントローラの
# initと衝突してブート毎に成否が変わっていた (実機計測で内部空き
# ~4.8KB/min_free枯渇を確認)。1KB超はPSRAMに流して内部連続を残す。
# DMA必須のallocはMALLOC_CAP_DMA明示なので影響しない。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# コンソール: USB-Serial-JTAG (GPIO19/20 のUSB-C) に出す。
# 既定は UART0 (GPIO43/44) で基板上のパッドにしか出ないため、
# 実機ログが USB-C ケーブル1本で取れるよう変更。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS 1000Hz
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE のみ (Bluedroid は使わない)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# BLE の内蔵RAM使用量を削る (LVGL描画バッファを内蔵SRAMに置くため
# こちらを削らないと BLE_INIT の malloc が失敗する — 実機確認済み)。
# NimBLE ホストプールを PSRAM に置く (一番でかい節約)。
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 時計は peripheral でスマホ1台だけ繋ぐ → observer/多重接続は不要。
# (CENTRAL は残す: ble_link が接続後の MTU 交換を ble_gattc_exchange_mtu
#  で自分から投げるので gattc が必要。外すとリンクが通らない)
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# コントローラの BLE activity 枠。connectable 広告は「広告1枠 + 着信
# 接続1枠」を占有するため最低2必要 (1 だと adv_start が HCI
# MEM_CAPACITY (0x0207) で失敗する — 実機確認済み)。
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# observer を切ったのでスキャン側キュー/キャッシュも不要 (コントローラ
# 側のプリコンパイル lib が内部RAMを占有するのを防ぐ)
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n

# ble_link (docs/protocol-v1.md): ボンド情報を NVS に保存して再接続を速くする
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# ATT MTU 要求値は 247 (protocol-v1.md)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# LE Secure Connections (Numeric Comparison) を必須にする
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
# 時計は同時に1台だけ繋ぐ (RAM 節約)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# ボンド保存時の NVS 書込みが nimble_host 上で走るため 4096 では
# スタックオーバーフローする。mbedTLS SC 計算込みで 8192 に拡大。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# 電源管理: tickless idle で自動 light sleep (plan.md L 章)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# light sleep 中の CPU パワードメイン OFF (既定y) は明示的に切る。
# 有効だと esp_pm_configure 時に retention 用の内蔵SRAM を
# ~8.8KB (CPU) + ~9KB (tagmem) 連続で確保しようとするが、この機体は
# LVGL 描画バッファ16KB + BLE 30KB連続ブロックで内部RAMが逼迫し
# 確保に失敗して "sleep_cpu_configure: Failed to enable CPU power down
# during light sleep." と出る (失敗しても CPU 通電のまま light sleep は
# 動くので実害は警告のみ)。同じ動作を警告なしにするため n にする。
# 内部RAMに余裕ができたら y に戻すと light sleep 時 ~650uA 節約できる。
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n

# LVGL 描画バッファは esp_display.cpp が全面サイズを PSRAM に確保する
# (BSP_DISPLAY_LVGL_BUF_HEIGHT は使わない。転送は内蔵 SRAM の
# バウンスバッファ 8.2KB x2 経由)。

# LVGL: 公式サンプル 02_lvgl_demo_v9 / BSP v2 推奨設定ベース
# 日本語フォントはまだ無し (plan.md I 章)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OS_FREERTOS=y
# LVGL の fast_mem を IRAM に置くと ~104KB 食って IRAM が溢れる (vector の j が届かない)。
# フラッシュキャッシュ経由で遅くなるかは要実機確認。
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
# 文字盤 analog の盤面グラデ・chara_side のグロー (放射グラデ) で必要
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
# テーマ v2: PNG 背景・アイコン (lodepng) と .bin フォント (binfont from buffer)
# TODO(hw): 実機で確認 — lv_malloc が大きい PNG デコード領域を確保できるか
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77

# OTA: 新イメージの自己診断が通るまで旧イメージにロールバックできるようにする
# (起動後に ota::mark_valid_if_pending で確定)。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTPS OTA (esp_https_ota) のサーバ証明は CA バンドルで検証する
# (github.com 等)。通信先は dns 解決できる公開HTTPSのみ想定。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# 描画ベンチ (LVGL sysmon/perf_monitor): 300ms 固定周期の計測タイマーが
# 待機中も走り続けるため、試験用として完全に切る (T27 後の棚卸しで
# 「テスト用オーバーレイ残り」と指摘された名残)。再計測したいときは
# SYSMON=y + PERF_MONITOR=y (+LOG_MODE=y で UART 出力・overlay 無し)。
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
# LV_LOG → printf (perf_render_cb 等の ESP_LOGI とは別。障害解析用に残す)
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y

# 静的リストのスナップショット化 (ui::c::bake_scroll)。押しっぱスクロールを
# 全行再描画から画像ブリットに変えて軽量化する用途。
CONFIG_LV_USE_SNAPSHOT=y

# LVGL 描画スレッド優先度 (Kconfig 既定 3)。実機でスクロール中の
# バンド描画待ちを減らすため LVGL タスクと同じ 4 に上げる。
CONFIG_LV_DRAW_THREAD_PRIO=4

# 角曲率計測オーバーレイ (ui/Kconfig): 四隅に半径8px刻みの同心弧。
# 実機写真から角R≈100px・safe-area 32–36px を確定済みのため既定off。
# 再計測したいときは =y にする。
CONFIG_WATCH_DIAG_CORNERS=n

# main タスク: theme_apply の資産読み込み (fread→littlefs→flash) が深い。
# 3584 では mame 適用で overflow したため 8K に (app_main 完了で解放される)。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MAIN_TASK_STACK_SIZE=8192
