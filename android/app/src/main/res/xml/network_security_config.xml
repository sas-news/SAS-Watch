<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 応答サーバー (自前の muse2api / OpenAI 互換) は LAN の HTTP を使うことがある。
  ここに列挙したホストは cleartext を許可する (接続先が HTTPS なら不要)。
  既定値は想定アドレス。ユーザーが別の LAN アドレスを使う場合はここに追加する。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- 自前 muse2api (OpenAI 互換) の予定アドレス -->
        <domain includeSubdomains="false">192.168.10.10</domain>
        <!-- エミュレータ / 端末内サーバー -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
