# T49 spike: SDK components/muse/Kconfig のうち、chat 層が参照する設定だけを
# 最小限に写したもの。B-min で SAS-Watch に移植するときに必要な設定面の一覧でもある。
menu "Muse chat spike (T49)"

    config SPIKE_WITH_CHAT
        bool "T49 spike: compile the chat layer"
        default y
        help
            オフにすると noise_core だけでビルドする (S0)。サイズ差分の基準用。

    config MUSE_HATCH
        bool "Muse's own voice session (chat API)"
        default y
        depends on SPIKE_WITH_CHAT
        help
            SDK の chat 層 (muse_chat_session.cpp) をビルドする。PSRAM 前提。

    config MUSE_HATCH_COMPACT_BUFFERS
        bool "Smaller session buffers"
        depends on MUSE_HATCH
        default n

    config MUSE_REALTIME_VOICE
        bool "Live voice calls (not part of B-min)"
        default n

    config MUSE_REALTIME_VOICE_APP_ID
        string "App ID the voice session connects as"
        default "hatch-web"
        depends on MUSE_REALTIME_VOICE

    config MUSE_LATEST_REPLY
        bool "Keep the latest reply for rereading (not part of B-min)"
        default n

    config MUSE_BOARD_SENSECAP_WATCHER
        bool
        default n

    config MUSE_APP_VIEW
        bool
        default n

    config MUSE_WASM_APPS
        bool
        default n

    config MUSE_WAKEWORD_ENABLE
        bool
        default n

endmenu
